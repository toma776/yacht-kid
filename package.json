{
  "name": "yacht-kid",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "import": "node scripts/import.mjs",
    "import:foto": "node scripts/import-photos.mjs",
    "crawl": "node scripts/crawl.mjs",
    "analyze": "node scripts/analyze.mjs",
    "schema": "node scripts/schema.mjs",
    "test": "node --test --disable-warning=ExperimentalWarning",
    "import:turso": "node --env-file=.env.local scripts/import.mjs",
    "db:push": "node --env-file=.env.turso.local scripts/turso-push.mjs --push",
    "db:backup": "node --env-file=.env.turso.local scripts/turso-push.mjs --backup",
    "media:cloudinary": "node --env-file=.env.cloudinary.local scripts/media-to-cloudinary.mjs",
    "media:r2": "node --env-file=.env.r2.local scripts/media-to-r2.mjs",
    "mirror": "node scripts/mirror.mjs",
    "mirror:serve": "node scripts/mirror-serve.mjs",
    "video": "node scripts/video.mjs",
    "harta": "node scripts/harta-locatie.mjs && node scripts/harta-brain.mjs",
    "harta:brain": "node scripts/harta-brain.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "maplibre-gl": "4.7.1",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vercel/blob": "^2.8.2",
    "aws4fetch": "^1.0.20"
  }
}
