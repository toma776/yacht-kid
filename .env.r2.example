# Copiază ca .env.r2.local (ignorat de git) și completează din contul Cloudflare → R2.
# Apoi: npm run media:r2   (sau, fără să urce nimic: node scripts/media-to-r2.mjs --dry)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yacht-kid-media
# Adresa publică a bucket-ului (r2.dev sau domeniul propriu), fără „/” la final; aceeași valoare intră pe Vercel ca MEDIA_BASE_URL
R2_PUBLIC_URL=
